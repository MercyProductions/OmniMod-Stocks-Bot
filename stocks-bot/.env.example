DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
PORT=3001
TIMEZONE=America/Chicago
OMNIMOD_STOCKS_DATA_DIR=
STOCKS_CONFIG_SECRET=
STOCKS_MONITOR_MINUTES=5
STOCKS_DISCOVERY_MINUTES=15
# Enumerates Alpaca US equities across documented supported listing venues, then batches eligible snapshots.
# Configured symbols stay separate priorities; this cap limits deep work, not directory discovery. Strict signal gates remain downstream.
STOCKS_DYNAMIC_DISCOVERY=true
STOCKS_DYNAMIC_DISCOVERY_MAX_SYMBOLS=15
STOCKS_DYNAMIC_DISCOVERY_CACHE_MINUTES=15
# Optional: configure the same absolute reviewed ETP registry path and review age in both Stocks and ETF/ETP bot environments.
# ETF_ETP_CLASSIFICATION_PATH=
# ETF_ETP_CLASSIFICATION_MAX_AGE_DAYS=180
STOCKS_DAILY_HOUR=8
STOCKS_DAILY_MINUTE=30
STOCKS_MIN_SCORE=68
STOCKS_MAX_SIGNALS=5
STOCKS_MIN_PRICE=2
STOCKS_MIN_AVERAGE_VOLUME=500000
STOCKS_MIN_DATA_QUALITY=60
STOCKS_CONFIRMATION_SCANS=2
STOCKS_EARNINGS_BLACKOUT_DAYS=2
STOCKS_DAILY_CACHE_HOURS=8
STOCKS_ASSUMED_SLIPPAGE_BPS=8
STOCKS_MAX_SPREAD_BPS=35
STOCKS_RESEARCH_RETENTION_DAYS=730
STOCKS_MODEL_MIN_SAMPLES=80
STOCKS_MODEL_MIN_HOLDOUT=20
STOCKS_ENSEMBLE_BUY_PROBABILITY=62
STOCKS_ENSEMBLE_WATCH_PROBABILITY=54
STOCKS_MODEL_AUTO_TRAIN=true
STOCKS_ALLOW_RULE_ONLY_SIGNALS=false
STOCKS_RESEARCH_MODEL_MIN_SAMPLES=240
STOCKS_EXPERT_MIN_SAMPLES=120
STOCKS_MODEL_EMBARGO_MINUTES=240
STOCKS_MODEL_LOOKBACK_DAYS=365
STOCKS_LABEL_LOOKBACK_DAYS=14
STOCKS_COUNTERFACTUAL_SLIPPAGE_BPS=10
STOCKS_BOOTSTRAP_SAMPLES=300
STOCKS_MAX_SECTOR_SIGNALS=2
STOCKS_MAX_OPEN_POSITIONS=3
STOCKS_MAX_OPEN_RISK_R=2
STOCKS_EXECUTION_STRESS_BPS=10
STOCKS_INVESTMENT_DAILY_RESEARCH=true
STOCKS_MAX_PAIR_CORRELATION=85
STOCKS_DAILY_LOSS_LIMIT_R=3
STOCKS_CONSECUTIVE_LOSS_LIMIT=3
STOCKS_MIN_PORTFOLIO_EXPECTED_R=0.05
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
STOCKS_ALPACA_NEWS_ENABLED=false
ALPACA_DATA_FEED=iex
ALPACA_STREAM_ENABLED=true
ALPACA_STREAM_MAX_SYMBOLS=30
SEC_USER_AGENT=
FRED_API_KEY=
STOCKS_EVENT_CACHE_MINUTES=60
STOCKS_SEC_FILING_BLACKOUT_HOURS=4
STOCKS_CORPORATE_ACTION_BLACKOUT_DAYS=2
POST_ON_START=true
STOCKS_AUTO_PROVISION=false

# Optional shared cross-bot paper portfolio. Zero equity leaves legacy signal behavior unchanged.
OMNIMOD_PAPER_ACCOUNT_EQUITY_USD=0
# Required before shared paper reservations: effective all-in round-trip fees per share.
# Include applicable broker, venue and regulatory fees. Use 0 only if verified for your account.
STOCKS_ROUND_TRIP_FEES_PER_SHARE=
TRADING_RISK_STATE_PATH=
OMNIMOD_EMERGENCY_STOP=true
SHARED_MAX_QUOTE_AGE_MS=15000
SHARED_MAX_OPEN_MARK_AGE_MS=300000
SHARED_MAX_OPEN_POSITIONS=5
SHARED_MAX_TRADE_RISK_PCT=0.25
SHARED_MAX_TOTAL_OPEN_RISK_PCT=1
SHARED_MAX_GROSS_EXPOSURE_PCT=150
SHARED_MAX_DAILY_LOSS_PCT=1
SHARED_MAX_SPREAD_PCT=0.5
SHARED_MIN_REWARD_RISK=1.25
# Optional quote-only paper monitor, independently supervised beside the Discord scanner.
# 0 disables scheduling; 60..900 seconds enables it after restart. Does not submit broker orders.
# Uses existing configured Alpaca IEX (single venue) or SIP (entitlement required); delayed data is rejected.
PAPER_MONITOR_INTERVAL_SECONDS=0
