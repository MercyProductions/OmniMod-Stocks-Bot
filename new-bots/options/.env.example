# Independent Discord application (npm start). Never share its token/client ID with another market.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_DELIVERY_MODE=bot
# Name/avatar are set on this application in the Developer Portal.
SCAN_TIMEOUT_MINUTES=20
# Legacy webhook fields below are used only with DISCORD_DELIVERY_MODE=webhook.

# User-supplied timestamped primary-bot signals and synchronized option chains only.
OPTIONS_SESSION_FILE=examples/paper-session.json
# Provider setup: ../DATA_PROVIDER_SETUP.md. Free sandbox is delayed research; broker-data needs eligible access.
OPTIONS_SOURCE=manual
# Independent provider-backed underlying research (never an approved setup by itself).
# auto runs when Alpaca keys exist; missing keys produce explicit unknown coverage.
# Use disabled to preserve a baseline without this added research scan.
OPTIONS_DISCOVERY_SOURCE=auto
OPTIONS_DISCOVERY_FEED=iex
OPTIONS_DISCOVERY_MAX_CANDIDATES=12
OPTIONS_DISCOVERY_MAX_QUOTE_AGE_MS=15000
OPTIONS_DIRECTORY_REFRESH_MS=21600000
OPTIONS_DIRECTORY_CACHE_PATH=.cache/options-underlying-directory.json
OPTIONS_DISCOVERY_HISTORY_PATH=.cache/options-discovery-history
# Fixed, unvalidated intraday hypothesis. No approved setups or changes to production gates.
# Uses discovery's explicit IEX/SIP feed; an entitlement failure never silently changes feed.
OPTIONS_INTRADAY_RESEARCH_SOURCE=auto
OPTIONS_INTRADAY_RESEARCH_MAX_UNDERLYINGS=12
OPTIONS_INTRADAY_RESEARCH_BUDGET_MS=45000
OPTIONS_INTRADAY_RESEARCH_HISTORY_PATH=.cache/options-intraday-research
# Isolated unvalidated forward-paper experiment; never publishes approved setups.
# auto requires existing production Tradier data access. Sandbox observations cannot fill it.
# The shared paper emergency stop and explicit cost settings still apply.
OPTIONS_INDEPENDENT_PAPER_SOURCE=auto
OPTIONS_INDEPENDENT_PAPER_MAX_UNDERLYINGS=3
OPTIONS_INDEPENDENT_PAPER_BUDGET_MS=45000
# Independent Tradier chain inventory; delayed sandbox remains research-only.
OPTIONS_CONTRACT_DISCOVERY_SOURCE=auto
OPTIONS_CONTRACT_MAX_UNDERLYINGS=12
OPTIONS_CONTRACT_MAX_EXPIRATIONS=2
OPTIONS_CONTRACT_MIN_DTE=1
OPTIONS_CONTRACT_MAX_DTE=45
OPTIONS_CONTRACT_BUDGET_MS=45000
OPTIONS_EXPIRATION_REFRESH_MS=3600000
OPTIONS_EXPIRATION_CACHE_PATH=.cache/options-expirations
OPTIONS_CONTRACT_HISTORY_PATH=.cache/options-contract-history
OPTIONS_SIGNAL_SOURCE=manual
OPTIONS_PRIMARY_SIGNAL_MAX_AGE_MS=120000
OPTIONS_CATALYST_REVIEW_FILE=examples/catalyst-reviews.json
OPTIONS_CATALYST_REVIEW_MAX_AGE_MS=1800000
OPTIONS_ASSIGNMENT_REVIEW_MAX_AGE_MS=86400000
# Optional positive-only cash-dividend veto; never treats an empty response as clearance.
OPTIONS_ASSIGNMENT_DATA_SOURCE=manual
# Optional catalyst source: manual, finnhub, alpaca, or finnhub+alpaca for both feeds.
OPTIONS_CATALYST_SOURCE=manual
FINNHUB_API_KEY=
# Alpaca keys support independent underlying discovery and optional news/dividend screens.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
TRADIER_ENV=sandbox
TRADIER_TOKEN=
# Shared market-data request budget, per token/environment. These defaults leave
# headroom under documented ceilings (production 120/min; sandbox 60/min).
TRADIER_PRODUCTION_REQUESTS_PER_MINUTE=108
TRADIER_SANDBOX_REQUESTS_PER_MINUTE=54
# Optional absolute path or path relative to new-bots. All workers must share it.
TRADIER_SHARED_RATE_DIR=
OPTIONS_MAX_QUOTE_AGE_MS=10000
OPTIONS_MAX_OPEN_MARK_AGE_MS=300000
PAPER_ACCOUNT_EQUITY_USD=
TRADING_RISK_STATE_PATH=
OMNIMOD_EMERGENCY_STOP=true
OMNIMOD_LIVE_TRADING_ENABLED=false
OPTIONS_MAX_QUOTE_AGE_MS=10000
OPTIONS_MAX_LEG_SKEW_MS=3000
OPTIONS_MAX_LEG_SPREAD_PCT=15
OPTIONS_MAX_COMBO_SPREAD_PCT=25
OPTIONS_MIN_OPEN_INTEREST=100
OPTIONS_MIN_VOLUME=1
OPTIONS_MIN_DTE=1
OPTIONS_MAX_DTE=45
OPTIONS_FORCE_EXIT_BUFFER_MINUTES=5
OPTIONS_MIN_REWARD_RISK=1.5
# Per-contract round-trip assumptions; each is multiplied by both vertical legs.
OPTIONS_FEES_PER_CONTRACT_ROUND_TRIP=
OPTIONS_SLIPPAGE_RESERVE_PER_CONTRACT=
OPTIONS_MAX_TRADE_RISK_PCT=0.25
OPTIONS_MAX_TOTAL_OPEN_RISK_PCT=1
OPTIONS_MAX_GROSS_EXPOSURE_PCT=100
OPTIONS_MAX_DAILY_LOSS_PCT=1
SCAN_INTERVAL_MINUTES=2
DISCORD_WEBHOOK_URL=

# Optional separate quotes-only paper-position monitor, 60–900 seconds.
# 0 preserves scan-only monitoring. Configure authorized providers first.
# No discovery/history/order/Discord requests; open positions still monitored under the stop.
PAPER_MONITOR_INTERVAL_SECONDS=0
