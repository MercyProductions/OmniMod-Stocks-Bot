# Independent Discord application (npm start). Never share its token/client ID with another market.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_DELIVERY_MODE=bot
# Name/avatar are set on this application in the Developer Portal.
SCAN_TIMEOUT_MINUTES=20
# Legacy webhook fields below are used only with DISCORD_DELIVERY_MODE=webhook.

# Provider setup: ../DATA_PROVIDER_SETUP.md. Manual context is not a live contract scan.
# No permanent free live Futures adapter is currently integrated; paid setup preserves cost/risk gates.
FUTURES_SOURCE=manual
# Optional read-only position monitoring; requires a licensed Databento Live GLBX.MDP3 entitlement.
FUTURES_POSITION_MARK_SOURCE=manual
# Optional historical API research context. No requests occur until explicitly selected.
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3
# Optional scheduled refresh of unexpired contract-definition identities for diagnostics; never auto-approves contracts.
FUTURES_CONTRACT_DISCOVERY_ENABLED=false
# Whole configured dataset, independent of priority roots. Legacy: configured_roots.
FUTURES_CONTRACT_DISCOVERY_SCOPE=dataset
FUTURES_CONTRACT_DISCOVERY_CACHE=data/futures-contract-discovery.json
FUTURES_CONTRACT_DISCOVERY_CACHE_MINUTES=360
# Optional whole-dataset recent-bar research. No approved alerts or executable liquidity inferred.
FUTURES_ACTIVITY_DISCOVERY_ENABLED=false
FUTURES_ACTIVITY_DISCOVERY_CACHE=data/futures-activity-screen.json
FUTURES_ACTIVITY_MAX_CANDIDATES=20
FUTURES_ACTIVITY_MAX_CONTRACTS_PER_ROOT=1
FUTURES_ACTIVITY_LOOKBACK_MINUTES=30
FUTURES_ACTIVITY_MAX_BAR_AGE_MS=180000
# Opt-in behavior change: shortlist before deep data; existing ORB/risk gates still apply.
# Review pool uses schemaVersion 1 + sessionDate + dayTrades (operator_reviewed_paper_input).
# Requires current directory, verified USD contract metadata, licensed Live and Historical H1 sources.
FUTURES_ACTIVITY_ANALYSIS_ENABLED=false
FUTURES_ACTIVITY_REVIEW_FILE=
FUTURES_ACTIVITY_MAX_ANALYSIS=10
# Required positive per-scan estimate cap before historical bars may be requested; zero disables downloads.
FUTURES_MAX_SCAN_COST_USD=0
FUTURES_DATA_MAX_AGE_SECONDS=180
FUTURES_FILE=examples/futures.json
FUTURES_DAY_SESSION_FILE=examples/day-session.json
# Optional H1 trend source. Historical requests require verified active-contract raw symbols and use the remaining per-scan cost cap.
FUTURES_TREND_DATA_SOURCE=manual
FUTURES_H1_LOOKBACK_DAYS=7
FUTURES_H1_MIN_BARS=50
# Completed-hour queries reuse checksum-verified raw history; current metadata/freshness is rechecked each scan.
FUTURES_H1_CACHE=data/futures-h1-history.json
# Optional paid scheduled-event screen; requires Finnhub Economic Calendar Premium entitlement.
FUTURES_CATALYST_SOURCE=manual
FINNHUB_API_KEY=
# Optional licensed session feed: replay today's 1m bars and fresh MBP-1 BBO for explicitly verified active contracts.
FUTURES_DAY_DATA_SOURCE=manual
FUTURES_PRIMARY_SIGNAL_MAX_AGE_MS=300000
# Optional path override; defaults to new-bots/shared/data/primary-signals.jsonl.
OMNIMOD_SIGNAL_RESEARCH_PATH=
# Optional isolated directory for forward comparison runs; never use production state in fixtures.
OMNIMOD_FORWARD_SHADOW_STATE_DIR=
MAX_FUTURES=36
MAX_FUTURE_AGE_MINUTES=30
FUTURES_MAX_QUOTE_AGE_MS=5000
FUTURES_MAX_OPEN_MARK_AGE_MS=300000
FUTURES_MAX_POSITION_QUOTE_AGE_MS=5000
FUTURES_MAX_TRANSPORT_LAG_MS=2000
FUTURES_LIVE_QUOTE_TIMEOUT_MS=8000
FUTURES_LIVE_SESSION_TIMEOUT_MS=30000
FUTURES_MIN_ENTRY_BOOK_SIZE=1
FUTURES_MAX_SPREAD_PCT=0.05
FUTURES_MAX_TRADE_RISK_PCT=0.25
FUTURES_MAX_TOTAL_OPEN_RISK_PCT=1
FUTURES_MAX_GROSS_EXPOSURE_PCT=500
FUTURES_MAX_DAILY_LOSS_PCT=1
FUTURES_MIN_REWARD_RISK=1.5
FUTURES_MAX_INITIAL_MARGIN_PCT=25
# Block new entries this many hours before first notice (physical delivery) or last trade (cash settled).
FUTURES_DELIVERY_ENTRY_BUFFER_HOURS=24
FUTURES_ROUND_TRIP_FEES_PER_CONTRACT=
FUTURES_SLIPPAGE_RESERVE_PER_CONTRACT=
PAPER_ACCOUNT_EQUITY_USD=
OMNIMOD_EMERGENCY_STOP=true
OMNIMOD_LIVE_TRADING_ENABLED=false
TRADING_RISK_STATE_PATH=
SCAN_INTERVAL_MINUTES=15
DISCORD_ALERT_COOLDOWN_MINUTES=60
DISCORD_WEBHOOK_USERNAME=OmniMod Futures
DISCORD_WEBHOOK_AVATAR_URL=
DISCORD_WEBHOOK_URL=

# Optional separate quotes-only paper-position monitor, 60–900 seconds.
# 0 preserves scan-only monitoring. Configure authorized providers first.
# No discovery/history/order/Discord requests; open positions still monitored under the stop.
PAPER_MONITOR_INTERVAL_SECONDS=0
