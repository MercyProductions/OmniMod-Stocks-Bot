# Independent Discord application (npm start). Never share its token/client ID with another market.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_DELIVERY_MODE=bot
# Name/avatar are set on this application in the Developer Portal.
SCAN_TIMEOUT_MINUTES=20
# Legacy webhook fields below are used only with DISCORD_DELIVERY_MODE=webhook.

# Choose fixture or Alpaca. Alpaca is read-only and only supplies paper research inputs.
# Free/paid provider setup: ../DATA_PROVIDER_SETUP.md. IEX research and SIP execution quality stay distinct.
ETF_SOURCE=fixture
ETF_SESSION_FILE=examples/paper-session.json
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ETF_ALPACA_FEED=iex
# IEX is screening-only; SIP is required to qualify executable paper candidates.
# Full eligible directory gets cheap batched snapshots before capped news/history work.
# Baseline is retained solely for explicit comparisons, not full-market coverage.
ETF_DISCOVERY_MODE=full-market
# Optional priority symbols (max 200); breaks equal screen ranks, never restricts the universe.
ETF_SYMBOLS=
ETF_UNIVERSE_CACHE_PATH=.cache/etf-universe.json
ETF_UNIVERSE_REFRESH_MS=21600000
ETF_UNIVERSE_MAX_STALE_MS=172800000
ETF_DISCOVERY_MAX_CANDIDATES=200
ETF_DISCOVERY_HISTORY_PATH=.cache/etf-discovery-history
# Operator-reviewed leveraged/inverse wrappers are classified by default.
# Refresh citations/review dates every 180 days; stale wrapper symbols are fail-closed.
ETF_ETP_CLASSIFICATION_PATH=examples/etp-classifications.json
ETF_ETP_CLASSIFICATION_MAX_AGE_DAYS=180
ETF_CATALYST_REVIEW_FILE=examples/catalyst-reviews.json
ETF_MAX_CATALYST_REVIEW_AGE_MS=1800000
# Optional paid US macro-event screen; does not replace per-symbol catalyst reviews or Alpaca headline checks.
ETF_CATALYST_SOURCE=manual
FINNHUB_API_KEY=
PAPER_ACCOUNT_EQUITY_USD=
TRADING_RISK_STATE_PATH=
OMNIMOD_EMERGENCY_STOP=true
OMNIMOD_LIVE_TRADING_ENABLED=false
ETF_MAX_QUOTE_AGE_MS=15000
ETF_MAX_OPEN_MARK_AGE_MS=300000
# Optional descriptive same-time-of-day relative-volume history. Off by default.
ETF_TIME_OF_DAY_VOLUME_PROFILE_ENABLED=false
ETF_TOD_VOLUME_PROFILE_SYMBOLS_PER_SCAN=10
ETF_TOD_VOLUME_PROFILE_SYMBOLS_PER_DAY=10
ETF_TOD_VOLUME_CACHE_DIR=.cache/etf-tod-volume
ETF_MAX_SPREAD_PCT=0.5
ETF_MAX_TRADE_RISK_PCT=0.25
ETF_MAX_TOTAL_OPEN_RISK_PCT=1
ETF_MAX_GROSS_EXPOSURE_PCT=200
ETF_MAX_DAILY_LOSS_PCT=1
ETF_MIN_REWARD_RISK=1.5
ETF_ROUND_TRIP_FEES_PER_UNIT=
ETF_SLIPPAGE_RESERVE_PER_UNIT=
SCAN_INTERVAL_MINUTES=5
DISCORD_WEBHOOK_URL=

# Optional separate quotes-only paper-position monitor, 60–900 seconds.
# 0 preserves scan-only monitoring. Configure authorized providers first.
# No discovery/history/order/Discord requests; open positions still monitored under the stop.
PAPER_MONITOR_INTERVAL_SECONDS=0
