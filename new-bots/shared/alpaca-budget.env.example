# Optional shared PROCESS environment for all cooperating Alpaca callers.
# Load with the service environment or Node --env-file; see ALPACA_SHARED_BUDGET.md.
# Does not select a feed, activate a plan, or provide credentials.
ALPACA_REQUESTS_PER_MINUTE=180
# Keep the same path across bots. Relative paths use the new-bots root.
ALPACA_SHARED_RATE_DIR=shared/data/provider-limits/alpaca
# Blank groups by credential key. Use one nonsecret alias only for keys sharing a quota.
ALPACA_RATE_LIMIT_GROUP=
