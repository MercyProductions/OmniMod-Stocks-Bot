# Independent Discord application (npm start). Never share its token/client ID with another market.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_DELIVERY_MODE=bot
# Name/avatar are set on this application in the Developer Portal.
SCAN_TIMEOUT_MINUTES=20
# Legacy webhook fields below are used only with DISCORD_DELIVERY_MODE=webhook.

# Free/optional paid profiles and prerequisites: ../DATA_PROVIDER_SETUP.md
# From new-bots: npm run data:setup -- --bot forex --profile free
FOREX_SOURCE=disabled
OANDA_ENV=practice
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
FOREX_INSTRUMENTS=EUR_USD,GBP_USD
# Quote every account-listed FX pair cheaply. These pairs get priority only after quote/risk-quality checks.
FOREX_DYNAMIC_DISCOVERY=true
# This is the expensive history-analysis budget, not a market-directory limit.
FOREX_MAX_SCAN_INSTRUMENTS=20
# Account-scoped instrument metadata refresh (one minute to one day); fresh quotes are requested every scan.
FOREX_DIRECTORY_REFRESH_MS=3600000
# Optional advisory context only: explicit FX-pair -> related Stocks/Crypto tickers mapping.
FOREX_PRIMARY_SIGNAL_MAP_JSON={}
FOREX_PRIMARY_SIGNAL_MAX_AGE_MS=300000
# Dynamic mode derives USD conversion crosses from the account directory, including non-G10 currencies.
# Missing direct/inverse USD crosses, stale/non-tradeable quotes or missing costs still block paper entries.
FOREX_GRANULARITIES=M15,H1,H4,D
MAX_QUOTE_AGE_SECONDS=120
FOREX_TARGET_ATR_MULTIPLE=1.5
# Optional operator-maintained New York trading-session calendar overrides.
FOREX_CLOSED_SESSION_DATES=
FOREX_EARLY_CLOSES_ET_JSON={}
# Optional paid scheduled-event calendar. Requires Finnhub economic-calendar entitlement; absent/error/unsupported coverage blocks paper entries.
FOREX_CATALYST_SOURCE=manual
FINNHUB_API_KEY=
FOREX_CATALYST_CLEAR=false
FOREX_CATALYST_REVIEWED_AT=
FOREX_CATALYST_REVIEW_SOURCE=
FOREX_CATALYST_REVIEW_SUMMARY=
# USD pairs convert at 1; FX losses use direct ask/inverse bid, gains use direct bid/inverse ask.
# These paper conversion factors are frozen at proposal; later FX conversion movement/charges are not modeled.
FOREX_ROUND_TRIP_FEES_PER_UNIT=
FOREX_SLIPPAGE_RESERVE_PER_UNIT=
FOREX_MAX_SPREAD_PCT=0.03
FOREX_MAX_TRADE_RISK_PCT=0.25
FOREX_MAX_TOTAL_OPEN_RISK_PCT=1
FOREX_MAX_GROSS_EXPOSURE_PCT=200
FOREX_MAX_DAILY_LOSS_PCT=1
FOREX_MIN_REWARD_RISK=1.5
PAPER_ACCOUNT_EQUITY_USD=
OMNIMOD_EMERGENCY_STOP=true
OMNIMOD_LIVE_TRADING_ENABLED=false
TRADING_RISK_STATE_PATH=
SCAN_INTERVAL_MINUTES=15
DISCORD_ALERT_COOLDOWN_MINUTES=30
DISCORD_WEBHOOK_USERNAME=OmniMod Forex
DISCORD_WEBHOOK_AVATAR_URL=
DISCORD_WEBHOOK_URL=

# Optional separate quotes-only paper-position monitor, 60–900 seconds.
# 0 preserves scan-only monitoring. Configure authorized providers first.
# No discovery/history/order/Discord requests; open positions still monitored under the stop.
PAPER_MONITOR_INTERVAL_SECONDS=0
